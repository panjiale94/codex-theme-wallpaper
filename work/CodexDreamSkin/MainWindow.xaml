<Window x:Class="CodexDreamSkin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 动态皮肤 · 开机恢复与自动修复 v7" Width="1050" Height="835" MinWidth="940" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="#090F1C" Foreground="#E8EEF8">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FBFF"/><Setter Property="Background" Value="#243551"/>
            <Setter Property="Padding" Value="14,10"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="CardBorder" BorderBrush="#28354C" BorderThickness="2" CornerRadius="10" Background="#172136" Padding="5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#EDAE69"/><Setter TargetName="CardBorder" Property="Background" Value="#302C33"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#6997B8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Codex 动态皮肤" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="轻量守护 · Codex 重开自动恢复 · Windows 登录后恢复" Foreground="#91A5BF" Margin="0,5,0,0" FontSize="14"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#202B3F" CornerRadius="12" Padding="13,7">
                <TextBlock x:Name="StateText" Text="尚未启用" Foreground="#EDBD83" FontSize="13"/>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#121D30" CornerRadius="14" Padding="17">
                <StackPanel>
                    <TextBlock Text="当前选择" FontSize="14" Foreground="#8EA4BF"/>
                    <Image x:Name="SelectedPreview" Height="125" Stretch="UniformToFill" Margin="0,12,0,12"/>
                    <TextBlock x:Name="MediaName" Text="不知火 · 离岛焰舞" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MediaDescription" Text="暖金蝶火 · 海面流光 · 灯影呼吸" Foreground="#9EB5CE" Margin="0,7,0,18" FontSize="12"/>
                    <Button Content="导入图片 / 动图 / 视频" Click="ChooseMedia_Click" Margin="0,0,0,8"/>
                    <Button Content="导入当前桌面视频" Click="ImportDesktop_Click" Margin="0,0,0,18"/>
                    <Border Background="#192941" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                        <TextBlock Text="启用后正常打开 Codex 即可恢复主题。普通启动可能快速重开一次；关闭效果会撤销自动恢复。" FontSize="12" Foreground="#B4CBE0"/>
                    </Border>
                    <CheckBox x:Name="AutoStartCheckBox" Content="Windows 登录后自动恢复" Foreground="#B4CBE0" Margin="0,0,0,16" IsChecked="True" Click="AutoStart_Click"/>
                    <Button x:Name="StartButton" Content="应用主题 / 启动 Codex" Click="Start_Click" Background="#AD633C" Margin="0,0,0,9"/>
                    <Button x:Name="StopButton" Content="关闭效果" Click="Stop_Click" Background="#293C58"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="选择主题" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="已开启时，点击即可切换" HorizontalAlignment="Right" Foreground="#8299B4" FontSize="12" VerticalAlignment="Center"/></DockPanel>
                <ListBox x:Name="ThemeList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ThemeList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding Thumbnail}" Height="108" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="6,9,6,4"/>
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9AAEC6" Margin="6,0,6,6"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="4" Background="#131F33" CornerRadius="12" Padding="17,13">
                    <StackPanel>
                        <DockPanel><TextBlock Text="面板遮罩" FontSize="13"/><TextBlock x:Name="OpacityValue" Text="35%" HorizontalAlignment="Right" Foreground="#EAB177"/></DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="10" Maximum="85" Value="35" ValueChanged="SettingsSlider_ValueChanged" Margin="0,7,0,10"/>
                        <DockPanel><TextBlock Text="动效强度" FontSize="13"/><TextBlock x:Name="MotionValue" Text="70%" HorizontalAlignment="Right" Foreground="#EAB177"/></DockPanel>
                        <Slider x:Name="MotionSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="SettingsSlider_ValueChanged" Margin="0,7,0,0"/>
                        <Button Content="强动效 100%" Click="BoostMotion_Click" HorizontalAlignment="Right" Padding="12,6" Margin="0,7,0,0" Background="#76523E"/>
                        <TextBlock Text="新主题含局部发尾 / 衣摆风场、旋焰蝶群、流雾及场景动效。遮罩 20%～35% 更沉浸。" FontSize="11" Foreground="#8297B0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="4" Background="#112137" CornerRadius="10" Padding="14,11">
            <TextBlock x:Name="StatusText" Text="选择主题并应用。已运行的 Codex 保留当前工作，下次正常打开时自动恢复。" Foreground="#B4D3E5" FontSize="12"/>
        </Border>
    </Grid>
</Window>
