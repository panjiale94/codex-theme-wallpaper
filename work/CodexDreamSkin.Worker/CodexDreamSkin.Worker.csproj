<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexDreamSkin.Worker</AssemblyName>
    <Version>5.0.0</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CodexDreamSkin\CdpClient.cs" Link="CdpClient.cs" />
    <Compile Include="..\CodexDreamSkin\SkinController.cs" Link="SkinController.cs" />
    <Compile Include="..\CodexDreamSkin\SkinWorker.cs" Link="SkinWorker.cs" />
    <Compile Include="..\CodexDreamSkin\SkinLog.cs" Link="SkinLog.cs" />
    <Compile Include="..\CodexDreamSkin\ThemeSettings.cs" Link="ThemeSettings.cs" />
    <Compile Include="..\CodexDreamSkin\ThemeDefinitions.cs" Link="ThemeDefinitions.cs" />
    <Compile Include="..\CodexDreamSkin\WorkerClient.cs" Link="WorkerClient.cs" />
    <Compile Include="..\CodexDreamSkin\MediaStore.cs" Link="MediaStore.cs" />
    <Compile Include="..\CodexDreamSkin\StartupIntegration.cs" Link="StartupIntegration.cs" />
    <EmbeddedResource Include="..\CodexDreamSkin\SkinRuntime.js" LogicalName="CodexDreamSkin.SkinRuntime.js" />
    <EmbeddedResource Include="..\CodexDreamSkin\EffectRuntime.js" LogicalName="CodexDreamSkin.EffectRuntime.js" />
    <None Include="..\CodexDreamSkin\Assets\*.png" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
